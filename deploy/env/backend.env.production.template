# Backend/.env for mas-sons.step-now.de — written ONCE by scripts/deploy.sh when Backend/.env is
# missing; @@…@@ placeholders are replaced with freshly generated secrets. After that the file on
# the server is the source of truth (deploy.sh never overwrites it; it only validates it).
APP_NAME="M.A.S & SONS Backend"
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_TO_FILE=True

# Own database + own role on the shared PostgreSQL. deploy.sh creates both from these values and
# keeps the role's password in sync with DB_PASSWORD on every run.
DB_TYPE=postgresql+psycopg
DB_USERNAME=mas_sons
DB_PASSWORD=@@DB_PASSWORD@@
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mas_sons
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=60000

# Unset on purpose: RedisClient fails open (rate limiting + idempotency off, WebSocket local-only).
REDIS_URL=

SECRET_KEY=@@SECRET_KEY@@
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAGIC_LINK_TOKEN_EXPIRE_MINUTES=15
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

COOKIE_AUTH_ENABLED=True
COOKIE_SAMESITE=lax
# Host-only cookies: never shared with step-now.de or any other subdomain.
COOKIE_DOMAIN=

INTERNAL_JOBS_SERVICE_TOKEN=@@INTERNAL_JOBS_SERVICE_TOKEN@@

# A demo never emails real people — messages are logged, not sent.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@step-now.de
EMAIL_FROM_NAME="M.A.S & SONS"

STORAGE_PROVIDER=local
# Uploads are served by nginx at https://mas-sons.step-now.de/uploads/ → FastAPI.
PUBLIC_BASE_URL=https://mas-sons.step-now.de
BACKEND_CORS_ORIGINS=https://mas-sons.step-now.de
