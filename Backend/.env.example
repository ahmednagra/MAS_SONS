# Never commit a real .env — this file documents the variable names only.

# --- Application ---
APP_NAME="M.A.S & SONS Backend"
ENVIRONMENT=development
DEBUG=False

# --- Database (config/settings.py assembles these into DATABASE_URL) ---
DB_TYPE=postgresql+psycopg
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mas_sons_development

# Pool sizing — see config/database.py's own comments before changing these;
# the worst-case connection budget is max_instances x (DB_POOL_SIZE + DB_MAX_OVERFLOW),
# which must stay under Cloud SQL max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=60000

# --- Redis (sharedinfrastructure.md — rate limiting, idempotency, WebSocket fan-out) ---
REDIS_URL=

# --- Auth (databaseschema.md §1 — multi-provider) ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
MAGIC_LINK_TOKEN_EXPIRE_MINUTES=15

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

COOKIE_AUTH_ENABLED=True
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Internal service-to-service auth (sharedinfrastructure.md §4) ---
INTERNAL_JOBS_SERVICE_TOKEN=

# --- CORS (comma-separated, e.g. https://app.masandsons.com,https://admin.masandsons.com) ---
BACKEND_CORS_ORIGINS=
